# Server only. Never prefix this with VITE_ or put it in browser code.
NEWS_API_KEY=
# Explicit sample data for local development; production refuses demo mode.
DEMO_MODE=true
CACHE_TTL_SECONDS=7200
# Additional time old headlines can be served if the upstream fails.
STALE_IF_ERROR_SECONDS=86400
CACHE_DIR=.cache/news
# Counts attempts, including failures, and persists across restarts (UTC day).
NEWS_API_DAILY_BUDGET=90
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_RETRY_SECONDS=60
# Internal API port. Docker exposes Nginx's PORT (default 8080) instead.
API_PORT=3001
